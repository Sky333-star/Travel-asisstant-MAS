# =============================================================================
# Wayfarer Travel Assistant — environment template
# Copy to `.env` and fill in. Every value below has a working default except
# HUGGINGFACE_API_KEY, which unlocks LLM-driven reasoning. Without it the system
# still runs end-to-end on the deterministic rule-based fallback planner.
# =============================================================================

# ---------- LLM (the ONLY key this project needs) ----------
HUGGINGFACE_API_KEY=
# Any chat-completion model served by HF Inference Providers.
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# Smaller/cheaper model used for high-frequency classification calls.
HF_FAST_MODEL=Qwen/Qwen2.5-7B-Instruct
# Speech-to-text model used by the /api/voice/transcribe fallback endpoint.
HF_STT_MODEL=openai/whisper-large-v3-turbo
HF_PROVIDER=auto
HF_TIMEOUT_SECONDS=90
HF_MAX_RETRIES=3

# ---------- Keyless data sources (no signup, no API key) ----------
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
FRANKFURTER_URL=https://api.frankfurter.app
# NOTE: restcountries.com moved behind an authorization key, so country
# facts now ship bundled in mcp_servers/common/countries.py. No URL needed.
OURAIRPORTS_URL=https://davidmegginson.github.io/ourairports-data/airports.csv

# OSM Nominatim's usage policy REQUIRES an identifying User-Agent with contact.
OSM_USER_AGENT=WayfarerTravelAssistant/1.0 (jenis01101@outlook.com)
# Nominatim allows max 1 request/second. Do not raise this.
NOMINATIM_RATE_LIMIT_RPS=1.0
OVERPASS_RATE_LIMIT_RPS=0.5
HTTP_CACHE_TTL_SECONDS=3600
HTTP_CACHE_DIR=data/cache

# ---------- Backend ----------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHECKPOINT_DB=data/checkpoints/wayfarer.sqlite
MAX_PLAN_REVISIONS=3
DEFAULT_CURRENCY=EUR

# ---------- MCP ----------
# stdio launches each server as a subprocess (default, zero config).
MCP_TRANSPORT=stdio
MCP_STARTUP_TIMEOUT=45
MCP_TOOL_TIMEOUT=60
MCP_ENABLED_SERVERS=weather,geo,flights,hotels,currency

# ---------- Observability (all free / open source) ----------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=wayfarer-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
METRICS_ENABLED=true

# Langfuse — free cloud tier at cloud.langfuse.com, or self-host with
# `docker compose -f observability/docker-compose.observability.yml up`
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_APP_NAME=Wayfarer
